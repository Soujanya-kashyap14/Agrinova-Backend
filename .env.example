# EcoAgri Intelligence — Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=EcoAgri Intelligence API
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# MongoDB Atlas — replace with your connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ecoagri

# JWT — use a long random string in production
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — comma-separated frontend URLs
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/jpg

# Gemini — powers the AgriNova assistant's answers (voice and text chat)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenWeather — used for live current-conditions weather data
# Get a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Groq (optional) — cloud Whisper large-v3 for voice recognition.
# When set, voice recognition uses this instead of the local
# Whisper "small" model: much higher accuracy and much faster,
# since it runs on Groq's hardware rather than this machine's CPU.
# Leave blank to use the local model only. Free key at
# https://console.groq.com/keys
GROQ_API_KEY=
